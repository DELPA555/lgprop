# ── Supabase (renderer) ───────────────────────────────────────────────
# Estas dos son públicas por diseño (la seguridad la da RLS en Postgres).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon-key...

# ── Edge Functions / servidor (NO exponer al renderer) ────────────────
# Se cargan como secrets en Supabase (supabase secrets set ...), no en el .exe.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role...
# RESEND_API_KEY=re_...
# EMAIL_FROM="LG Prop <avisos@tudominio.com>"
